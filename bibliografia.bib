url = {https://www.sciencedirect.com/science/article/pii/S0168900213012771},
author = {C. Amole and G.B. Andresen and M.D. Ashkezari and M. Baquero-Ruiz and W. Bertsche and P.D. Bowe and E. Butler and A. Capra and P.T. Carpenter and C.L. Cesar and S. Chapman and M. Charlton and A. Deller and S. Eriksson and J. Escallier and J. Fajans and T. Friesen and M.C. Fujiwara and D.R. Gill and A. Gutierrez and J.S. Hangst and W.N. Hardy and R.S. Hayano and M.E. Hayden and A.J. Humphries and J.L. Hurt and R. Hydomako and C.A. Isaac and M.J. Jenkins and S. Jonsell and L.V. Jørgensen and S.J. Kerrigan and L. Kurchaninov and N. Madsen and A. Marone and J.T.K. McKenna and S. Menary and P. Nolan and K. Olchanski and A. Olin and B. Parker and A. Povilus and P. Pusa and F. Robicheaux and E. Sarid and D. Seddon and S. {Seif El Nasr} and D.M. Silveira and C. So and J.W. Storey and R.I. Thompson and J. Thornhill and D. Wells and D.P. {van der Werf} and J.S. Wurtele and Y. Yamazaki},
